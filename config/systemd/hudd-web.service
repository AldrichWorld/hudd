# Hudd web service. Copy to /etc/systemd/system/ and adjust the paths if Hudd is not in /opt/hudd.
[Unit]
Description=Hudd web service
After=network-online.target hudd-livekit.service
Wants=network-online.target

[Service]
User=hudd
WorkingDirectory=/opt/hudd/web
# Settings (keys, domain, limits) come from the same .env that deploy.sh writes
EnvironmentFile=/opt/hudd/.env
Environment=LIVEKIT_URL=ws://127.0.0.1:7880
ExecStart=/opt/hudd/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
