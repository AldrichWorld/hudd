# ============================================================
# Hudd settings. ./deploy.sh creates .env from this file on first run
# and fills in the keys and this machine's IP address for you.
# ============================================================

# ---------- Public server with a domain name ----------
# With DOMAIN set, Caddy gets a free HTTPS certificate and Hudd runs at https://DOMAIN
# Point the domain's A record at this server and open ports 80 and 443 first.
DOMAIN=
# Email for certificate notices from Let's Encrypt (required with DOMAIN)
ACME_EMAIL=
# Set to "host" if Nginx or Caddy on this machine already uses ports 80/443:
# Hudd then listens on 127.0.0.1:18080 only and your web server forwards to it (see the README)
REVERSE_PROXY=

# ---------- Who can start meetings ----------
# Leave empty and anyone who can open the site can start a meeting.
# Set a passcode to allow only people who know it (joining with a link never needs it).
CREATE_PASSCODE=

# ---------- Network ----------
# This machine's IP: LAN IP at home or in the office, public IP on a server. Empty = detected by deploy.sh
PUBLIC_HOST=
# Web ports. Local mode uses 8080/8443; with DOMAIN, deploy.sh switches to 80/443
HTTP_PORT=8080
HTTPS_PORT=8443
# LiveKit media ports (open them in your firewall: TCP 7881, UDP 7882)
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# ---------- Meetings ----------
# How long a new meeting waits for its first person, and how long it stays after the last person leaves (seconds)
ROOM_EMPTY_TIMEOUT=1800
ROOM_DEPARTURE_TIMEOUT=120
# Abuse limits per visitor IP (0 = no limit)
ROOMS_PER_HOUR_PER_IP=20
OPEN_ROOMS_PER_IP=10

# ---------- Branding ----------
# Name shown in the pages and the installed app
APP_NAME=Hudd
# Link to the source code in the page footer (empty = hide it)
SOURCE_URL=https://github.com/AldrichWorld/hudd

# ---------- Generated by deploy.sh (leave empty) ----------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SECRET_KEY=
